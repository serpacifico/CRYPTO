// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Velas por Dentro PRO — Compradores vs Vendedores
// Cada vela se dibuja hueca (borde azul = alcista, rojo = bajista) y por dentro se rellena
// con el reparto REAL de volumen comprador (verde, abajo) y vendedor (rojo, arriba).
// El reparto se calcula con las velas de una temporalidad inferior (request.security_lower_tf):
// el volumen de cada vela interna que cierra arriba cuenta como compra y el de la que cierra abajo, como venta.
// IMPORTANTE: oculta las velas normales del gráfico (Configuración > Símbolo > desmarca Cuerpo, Bordes y Mecha).

//@version=6
indicator("Velas por Dentro PRO", shorttitle = "VxD PRO", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Entradas ─────────────────────────────
grpData   = "Datos internos"
ltfMode   = input.string("Auto", "Temporalidad interna", options = ["Auto", "Manual"], group = grpData, tooltip = "Auto: gráfico hasta 1H → 1m, hasta 4H → 5m, hasta 1D → 15m, mayor → 1H.\nEn gráfico de 1m elige Manual y 1S (requiere plan con segundos).")
ltfManual = input.timeframe("1", "TF interna (modo Manual)", group = grpData)

grpVis      = "Visual"
upOutline   = input.color(#4FC3F7, "Borde vela alcista", group = grpVis)
dnOutline   = input.color(#EF5350, "Borde vela bajista", group = grpVis)
buyCol      = input.color(#26D07C, "Compradores (dentro)", group = grpVis)
sellCol     = input.color(#FF5C6C, "Vendedores (dentro)", group = grpVis)
showDiv     = input.bool(true, "Resaltar divergencias en amarillo", group = grpVis, tooltip = "Vela roja con más compradores dentro, o vela verde con más vendedores dentro.")
divCol      = input.color(#FFC107, "Color divergencia", group = grpVis)
divThr      = input.int(60, "Divergencia si el bando contrario ≥ %", 50, 100, group = grpVis, tooltip = "Con 50 casi cualquier vela sale amarilla. 60 = solo cuando el bando contrario ganó con claridad. Sube a 65–70 en monedas pequeñas o muy volátiles.")
fillMode    = input.string("Color dominante", "Modo de relleno", options = ["Color dominante", "Apilado"], group = grpVis, tooltip = "Color dominante: toda la vela del color del bando que ganó; más intenso cuanto mayor la ventaja (ideal con zoom alejado).\nApilado: verde abajo = % compradores, rojo arriba = % vendedores (como el vídeo; mejor con zoom cercano).")
innerTransp = input.int(15, "Transparencia del relleno", 0, 90, group = grpVis)
showPct     = input.bool(false, "Mostrar % de compra bajo cada vela", group = grpVis)
showTable   = input.bool(true, "Mostrar panel", group = grpVis)

grpSig    = "Retroceso débil y señales"
showSig   = input.bool(true, "Detectar retrocesos débiles", group = grpSig)
minPull   = input.int(2, "Velas mínimas del retroceso", 1, group = grpSig)
weakRatio = input.int(50, "% mínimo de velas del retroceso con dominio contrario", 0, 100, group = grpSig, tooltip = "En un retroceso bajista (velas rojas) dentro de tendencia alcista: % de esas velas rojas que por dentro tienen más compradores.")
useTrend  = input.bool(true, "Filtrar con EMA de tendencia", group = grpSig)
emaLen    = input.int(50, "Longitud EMA", 2, group = grpSig)
maxWait   = input.int(10, "Velas máximas para romper el nivel", 1, group = grpSig)

// ───────────────────────────── Volumen comprador / vendedor ─────────────────────────────
autoLTF() =>
    s = timeframe.in_seconds()
    s <= 3600 ? "1" : s <= 14400 ? "5" : s <= 86400 ? "15" : "60"

ltf = ltfMode == "Auto" ? autoLTF() : ltfManual
if timeframe.in_seconds(ltf) > timeframe.in_seconds()
    runtime.error("La temporalidad interna debe ser menor o igual que la del gráfico.")

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, close, volume])

float upV   = 0.0
float dnV   = 0.0
int   n     = array.size(ltfC)
bool  estim = n == 0
if n > 0
    float prevC = close[1]
    for i = 0 to n - 1
        o  = ltfO.get(i)
        c  = ltfC.get(i)
        vi = ltfV.get(i)
        w  = na(vi) ? 1.0 : vi
        if c > o
            upV += w
        else if c < o
            dnV += w
        else if c > prevC
            upV += w
        else if c < prevC
            dnV += w
        else
            upV += w / 2
            dnV += w / 2
        prevC := c
else
    // Sin datos internos (historia antigua): estimación por la posición del cierre en el rango
    w    = na(volume) ? 1.0 : volume
    rng  = high - low
    frac = rng > 0 ? (close - low) / rng : 0.5
    upV  := w * frac
    dnV  := w * (1 - frac)

tot    = upV + dnV
buyPct = tot > 0 ? upV / tot : 0.5
delta  = upV - dnV

// ───────────────────────────── Dibujo de la vela ─────────────────────────────
bodyTop   = math.max(open, close)
bodyBot   = math.min(open, close)
split     = bodyBot + (bodyTop - bodyBot) * buyPct
isUp      = close >= open
divergent = (close < open and buyPct * 100 >= divThr) or (close > open and (1 - buyPct) * 100 >= divThr)
outline   = showDiv and divergent ? divCol : isUp ? upOutline : dnOutline
fillTr    = estim ? math.min(innerTransp + 45, 95) : innerTransp
noCol     = color.new(color.black, 100)

// Color dominante: 50 % → casi transparente, 100 % → color pleno
stacked = fillMode == "Apilado"
edge    = math.abs(buyPct - 0.5) * 2
domTr   = math.min(fillTr + (1 - edge) * (90 - fillTr), 95)
domCol  = color.new(buyPct >= 0.5 ? buyCol : sellCol, domTr)

plotcandle(open, high, low, close, "Vela (borde, mechas y color dominante)", color = stacked ? noCol : domCol, wickcolor = outline, bordercolor = outline)
plotcandle(stacked ? bodyBot : na, stacked ? split : na, stacked ? bodyBot : na, stacked ? split : na, "Compradores", color = color.new(buyCol, fillTr), wickcolor = noCol, bordercolor = outline)
plotcandle(stacked ? split : na, stacked ? bodyTop : na, stacked ? split : na, stacked ? bodyTop : na, "Vendedores", color = color.new(sellCol, fillTr), wickcolor = noCol, bordercolor = outline)

if showPct
    label.new(bar_index, low, str.tostring(buyPct * 100, "#"), yloc = yloc.belowbar, style = label.style_none, textcolor = buyPct >= 0.5 ? buyCol : sellCol, size = size.tiny)

// ───────────────────────────── Retroceso débil → nivel → ruptura ─────────────────────────────
ema = ta.ema(close, emaLen)

var int   rL    = 0     // velas rojas seguidas (retroceso dentro de subida)
var int   rW    = 0     // de ellas, con más compradores dentro
var float rLow  = na
var int   gL    = 0     // velas verdes seguidas (retroceso dentro de bajada)
var int   gW    = 0     // de ellas, con más vendedores dentro
var float gHigh = na

var int   pDir  = 0
var float pLvl  = na
var float pStop = na
var int   pAge  = 0
var line  pLine = na
var line  sLine = na

longSetup  = false
shortSetup = false
longSig    = false
shortSig   = false

if showSig and barstate.isconfirmed
    // 1) Seguimiento del nivel pendiente
    if pDir != 0
        pAge += 1
        broke   = pDir == 1 ? close > pLvl : close < pLvl
        invalid = pDir == 1 ? close < pStop : close > pStop
        if broke
            longSig  := pDir == 1
            shortSig := pDir == -1
            line.set_x2(pLine, bar_index)
            line.set_x2(sLine, bar_index)
            pDir := 0
        else if invalid or pAge > maxWait
            line.set_x2(pLine, bar_index)
            line.set_x2(sLine, bar_index)
            line.set_color(pLine, color.gray)
            pDir := 0
        else
            line.set_x2(pLine, bar_index + 1)
            line.set_x2(sLine, bar_index + 1)

    // 2) Construcción de retrocesos y detección del giro
    if close < open
        if gL >= minPull and gW * 100 >= weakRatio * gL and buyPct < 0.5 and (not useTrend or close < ema)
            shortSetup := true
            pDir  := -1
            pLvl  := low
            pStop := math.max(gHigh, high)
        gL    := 0
        gW    := 0
        gHigh := na
        rLow  := rL == 0 ? low : math.min(rLow, low)
        rL    += 1
        rW    += buyPct > 0.5 ? 1 : 0
    else if close > open
        if rL >= minPull and rW * 100 >= weakRatio * rL and buyPct > 0.5 and (not useTrend or close > ema)
            longSetup := true
            pDir  := 1
            pLvl  := high
            pStop := math.min(rLow, low)
        rL    := 0
        rW    := 0
        rLow  := na
        gHigh := gL == 0 ? high : math.max(gHigh, high)
        gL    += 1
        gW    += buyPct < 0.5 ? 1 : 0

    if longSetup or shortSetup
        pAge  := 0
        lc     = longSetup ? upOutline : dnOutline
        pLine := line.new(bar_index, pLvl, bar_index + 1, pLvl, color = lc, width = 2)
        sLine := line.new(bar_index, pStop, bar_index + 1, pStop, color = color.new(color.gray, 30), style = line.style_dotted)

plotshape(longSig, "Compra", shape.triangleup, location.belowbar, upOutline, size = size.small, text = "COMPRA", textcolor = upOutline)
plotshape(shortSig, "Venta", shape.triangledown, location.abovebar, dnOutline, size = size.small, text = "VENTA", textcolor = dnOutline)

alertcondition(showDiv and divergent and close < open, "Vela roja con compradores dentro", "VxD: vela roja dominada por compradores (venta débil).")
alertcondition(showDiv and divergent and close > open, "Vela verde con vendedores dentro", "VxD: vela verde dominada por vendedores (compra débil).")
alertcondition(longSetup, "Nivel de compra listo", "VxD: retroceso débil terminado. Vigila la ruptura del máximo.")
alertcondition(shortSetup, "Nivel de venta listo", "VxD: retroceso débil terminado. Vigila la ruptura del mínimo.")
alertcondition(longSig, "COMPRA confirmada", "VxD: ruptura alcista tras retroceso débil.")
alertcondition(shortSig, "VENTA confirmada", "VxD: ruptura bajista tras retroceso débil.")

// ───────────────────────────── Panel ─────────────────────────────
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(#0B1220, 10), border_color = color.new(color.gray, 70), border_width = 1)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "TF interna", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 0, ltf + " (" + str.tostring(n) + " velas)", text_color = n <= 1 ? color.orange : color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Compradores", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(buyPct * 100, "#") + "%", text_color = buyCol, text_size = size.small)
    table.cell(tb, 0, 2, "Vendedores", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(100 - buyPct * 100, "#") + "%", text_color = sellCol, text_size = size.small)
    table.cell(tb, 0, 3, "Delta", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(delta, format.volume), text_color = delta >= 0 ? buyCol : sellCol, text_size = size.small)
    table.cell(tb, 0, 4, "Nivel activo", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 4, pDir == 1 ? "Compra > " + str.tostring(pLvl, format.mintick) : pDir == -1 ? "Venta < " + str.tostring(pLvl, format.mintick) : "—", text_color = color.yellow, text_size = size.small)
