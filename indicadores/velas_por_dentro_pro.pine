// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Velas por Dentro PRO — estilo "cada vela te cuenta quién mandó"
// Cada vela de la temporalidad superior se dibuja HUECA (borde azul = alcista, rojo = bajista)
// y DENTRO lleva dos barras lado a lado: VERDE (izquierda) = compradores, ROJA (derecha) = vendedores.
// La barra más alta es el bando que mandó dentro de la vela.
// Compras y ventas salen de las velas internas (request.security_lower_tf): volumen de velas
// internas que cierran arriba = compra; que cierran abajo = venta.
// USO: pon el gráfico en una temporalidad MENOR (p. ej. 15m) y el indicador dibuja las velas de 1H.
// Oculta las velas normales: Configuración > Símbolo > desmarca Cuerpo, Bordes y Mecha.

//@version=6
indicator("Velas por Dentro PRO", shorttitle = "VxD PRO", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Entradas ─────────────────────────────
grpTF    = "Vela que se dibuja"
tfMode   = input.string("Auto", "Temporalidad de las velas", options = ["Auto", "Manual"], group = grpTF, tooltip = "Auto (gráfico → velas): 1m→5m, 3m→15m, 5m→30m, 15m→1H, 30m→2H, 1H→4H, 2H/4H→D, D→W, W→M")
tfManual = input.timeframe("60", "Temporalidad (modo Manual)", group = grpTF)

grpData   = "Datos internos"
ltfMode   = input.string("Auto", "TF para medir compras/ventas", options = ["Auto", "Manual"], group = grpData, tooltip = "Auto: gráfico hasta 1H → 1m, hasta 4H → 5m, mayor → 15m.")
ltfManual = input.timeframe("1", "TF interna (modo Manual)", group = grpData)

grpVis      = "Visual"
upOutline   = input.color(#4FC3F7, "Borde vela alcista", group = grpVis)
dnOutline   = input.color(#EF5350, "Borde vela bajista", group = grpVis)
buyCol      = input.color(#26D07C, "Barra compradores (izquierda)", group = grpVis)
sellCol     = input.color(#FF5C6C, "Barra vendedores (derecha)", group = grpVis)
heightMode  = input.string("Comparar (el que manda llena la vela)", "Altura de las barras", options = ["Comparar (el que manda llena la vela)", "% del cuerpo"], group = grpVis, tooltip = "Comparar: la barra del bando ganador ocupa todo el cuerpo y la otra su proporción (fácil de ver quién mandó).\n% del cuerpo: cada barra mide su % (ej. 70/30).")
borderW     = input.int(2, "Grosor del borde", 1, 4, group = grpVis)
innerTransp = input.int(0, "Transparencia de las barras", 0, 90, group = grpVis)
showDiv     = input.bool(true, "Resaltar divergencias en amarillo", group = grpVis, tooltip = "Vela roja donde mandaron los compradores, o vela azul donde mandaron los vendedores.")
divCol      = input.color(#FFC107, "Color divergencia", group = grpVis)
divThr      = input.int(60, "Divergencia si el bando contrario ≥ %", 50, 100, group = grpVis)
showPct     = input.bool(false, "Mostrar % de compradores bajo cada vela", group = grpVis)
showTable   = input.bool(true, "Mostrar panel", group = grpVis)

grpSig    = "Retroceso débil y señales"
showSig   = input.bool(true, "Detectar retrocesos débiles", group = grpSig)
minPull   = input.int(2, "Velas mínimas del retroceso", 1, group = grpSig)
weakRatio = input.int(50, "% de velas del retroceso con dominio contrario", 0, 100, group = grpSig, tooltip = "Retroceso bajista dentro de subida: % de esas velas rojas en las que mandaron los compradores.")
useTrend  = input.bool(true, "Filtrar con EMA (en velas dibujadas)", group = grpSig)
emaLen    = input.int(20, "Longitud EMA", 2, group = grpSig)
maxWait   = input.int(3, "Velas dibujadas para romper el nivel", 1, group = grpSig)

// ───────────────────────────── Temporalidades ─────────────────────────────
autoHTF() =>
    s = timeframe.in_seconds()
    s <= 60 ? "5" : s <= 180 ? "15" : s <= 300 ? "30" : s <= 900 ? "60" : s <= 1800 ? "120" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : "M"

autoLTF() =>
    s = timeframe.in_seconds()
    s <= 3600 ? "1" : s <= 14400 ? "5" : "15"

tfLabel(tf) =>
    s = timeframe.in_seconds(tf)
    s < 3600 ? str.tostring(s / 60, "#") + "m" : s < 86400 ? str.tostring(s / 3600, "#") + "H" : tf

htf  = tfMode == "Auto" ? autoHTF() : tfManual
ltf  = ltfMode == "Auto" ? autoLTF() : ltfManual
nExp = int(math.round(timeframe.in_seconds(htf) / timeframe.in_seconds()))
if nExp < 3
    runtime.error("Cada vela dibujada necesita al menos 3 velas del gráfico. Baja la temporalidad del gráfico (ej. 15m para ver velas de 1H).")
if timeframe.in_seconds(ltf) > timeframe.in_seconds()
    runtime.error("La TF interna debe ser menor o igual que la del gráfico.")

// Ancho de la vela dibujada (en barras, par para centrar la mecha)
evenW(n) =>
    w = n - 1
    math.max(w - w % 2, 2)

// ───────────────────────────── Compras / ventas de la barra del gráfico ─────────────────────────────
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, close, volume])

float upV   = 0.0
float dnV   = 0.0
int   nLtf  = array.size(ltfC)
bool  estim = nLtf == 0
if nLtf > 0
    float prevC = close[1]
    for i = 0 to nLtf - 1
        o  = ltfO.get(i)
        c  = ltfC.get(i)
        vi = ltfV.get(i)
        w  = na(vi) ? 1.0 : vi
        if c > o
            upV += w
        else if c < o
            dnV += w
        else if c > prevC
            upV += w
        else if c < prevC
            dnV += w
        else
            upV += w / 2
            dnV += w / 2
        prevC := c
else
    // Sin datos internos (historia antigua): estimación por la posición del cierre
    w    = na(volume) ? 1.0 : volume
    rng  = high - low
    frac = rng > 0 ? (close - low) / rng : 0.5
    upV  := w * frac
    dnV  := w * (1 - frac)

// ───────────────────────────── Estado de la vela dibujada ─────────────────────────────
var int   sBar = na
var int   mW   = 2
var float hO   = na
var float hH   = na
var float hL   = na
var float hC   = na
var float aUp  = 0.0
var float aDn  = 0.0
var int   nIn  = 0
var bool  aEst = false
var box   bBuy  = na
var box   bSell = na
var box   bOut  = na
var line  lWU   = na
var line  lWD   = na
var float hEma  = na

// Retrocesos (en velas dibujadas)
var int   rL    = 0
var int   rW    = 0
var float rLow  = na
var int   gL    = 0
var int   gW    = 0
var float gHigh = na

// Nivel pendiente
var int   pDir  = 0
var float pLvl  = na
var float pStop = na
var int   pAge  = 0
var line  pLine = na
var line  sLine = na

isNew      = timeframe.change(htf) or na(sBar)
longSetup  = false
shortSetup = false
longSig    = false
shortSig   = false

// ── Cierre de la vela dibujada anterior ──
if isNew and not na(sBar)
    // Ajuste de ancho si la vela tuvo menos barras de las esperadas (fines de sesión)
    if nIn < nExp
        mW := math.max(nIn - 1 - (nIn - 1) % 2, 0)
        midP = sBar + int(mW / 2)
        box.set_right(bOut, sBar + mW)
        box.set_right(bBuy, midP)
        box.set_left(bSell, midP)
        box.set_right(bSell, sBar + mW)
        line.set_x1(lWU, midP)
        line.set_x2(lWU, midP)
        line.set_x1(lWD, midP)
        line.set_x2(lWD, midP)

    totP = aUp + aDn
    bp   = totP > 0 ? aUp / totP : 0.5
    hEma := na(hEma) ? hC : hEma + (hC - hEma) * 2.0 / (emaLen + 1)

    if showPct
        label.new(sBar + int(mW / 2), hL, str.tostring(bp * 100, "#") + "%", style = label.style_label_up, color = color.new(color.black, 100), textcolor = bp >= 0.5 ? buyCol : sellCol, size = size.tiny)

    if showSig
        if pDir != 0
            pAge += 1
            if pAge > maxWait
                line.set_color(pLine, color.gray)
                pDir := 0
        if hC < hO
            // Vela roja: ¿termina un rebote débil dentro de bajada?
            if gL >= minPull and gW * 100 >= weakRatio * gL and bp < 0.5 and (not useTrend or hC < hEma)
                shortSetup := true
                pDir  := -1
                pLvl  := math.min(hO, hC)
                pStop := math.max(gHigh, hH)
            gL    := 0
            gW    := 0
            gHigh := na
            rLow  := rL == 0 ? hL : math.min(rLow, hL)
            rL    += 1
            rW    += bp > 0.5 ? 1 : 0
        else if hC > hO
            // Vela azul: ¿termina un retroceso débil dentro de subida?
            if rL >= minPull and rW * 100 >= weakRatio * rL and bp > 0.5 and (not useTrend or hC > hEma)
                longSetup := true
                pDir  := 1
                pLvl  := math.max(hO, hC)
                pStop := math.min(rLow, hL)
            rL    := 0
            rW    := 0
            rLow  := na
            gHigh := gL == 0 ? hH : math.max(gHigh, hH)
            gL    += 1
            gW    += bp < 0.5 ? 1 : 0

        if longSetup or shortSetup
            pAge  := 0
            lc     = longSetup ? upOutline : dnOutline
            // Línea desde el cuerpo de la vela de giro hacia la derecha (como en el vídeo)
            pLine := line.new(sBar, pLvl, bar_index, pLvl, color = lc, width = 2)
            sLine := line.new(sBar, pStop, bar_index, pStop, color = color.new(color.gray, 30), style = line.style_dotted)

// ── Nueva vela dibujada: reiniciar ──
if isNew
    sBar := bar_index
    mW   := evenW(nExp)
    hO   := open
    hH   := high
    hL   := low
    aUp  := 0.0
    aDn  := 0.0
    nIn  := 0
    aEst := false
    bBuy  := box.new(sBar, open, sBar, open, border_color = color.new(color.black, 100), border_width = 0, bgcolor = color.new(buyCol, innerTransp))
    bSell := box.new(sBar, open, sBar, open, border_color = color.new(color.black, 100), border_width = 0, bgcolor = color.new(sellCol, innerTransp))
    bOut  := box.new(sBar, open, sBar, open, border_width = borderW, bgcolor = color.new(color.black, 100))
    lWU   := line.new(sBar, open, sBar, open, width = borderW)
    lWD   := line.new(sBar, open, sBar, open, width = borderW)
else
    hH := math.max(hH, high)
    hL := math.min(hL, low)
hC   := close
aUp  += upV
aDn  += dnV
nIn  += 1
aEst := aEst or estim

// ── Dibujo / actualización de la vela ──
top     = math.max(hO, hC)
bot     = math.min(hO, hC)
body    = top - bot
tot     = aUp + aDn
bpNow   = tot > 0 ? aUp / tot : 0.5
mx      = math.max(aUp, aDn)
hBuy    = heightMode == "% del cuerpo" ? body * bpNow : mx > 0 ? body * aUp / mx : body / 2
hSell   = heightMode == "% del cuerpo" ? body * (1 - bpNow) : mx > 0 ? body * aDn / mx : body / 2
isUp    = hC >= hO
diverg  = (hC < hO and bpNow * 100 >= divThr) or (hC > hO and (1 - bpNow) * 100 >= divThr)
outline = showDiv and diverg ? divCol : isUp ? upOutline : dnOutline
fillTr  = aEst ? math.min(innerTransp + 50, 95) : innerTransp
rightX  = sBar + mW
midX    = sBar + int(mW / 2)

box.set_lefttop(bBuy, sBar, bot + hBuy)
box.set_rightbottom(bBuy, midX, bot)
box.set_bgcolor(bBuy, color.new(buyCol, fillTr))
box.set_lefttop(bSell, midX, bot + hSell)
box.set_rightbottom(bSell, rightX, bot)
box.set_bgcolor(bSell, color.new(sellCol, fillTr))
box.set_lefttop(bOut, sBar, top)
box.set_rightbottom(bOut, rightX, bot)
box.set_border_color(bOut, outline)
line.set_xy1(lWU, midX, hH)
line.set_xy2(lWU, midX, top)
line.set_color(lWU, outline)
line.set_xy1(lWD, midX, bot)
line.set_xy2(lWD, midX, hL)
line.set_color(lWD, outline)

// ── Ruptura del nivel (se comprueba en cada vela del gráfico ya cerrada) ──
if showSig and pDir != 0 and barstate.isconfirmed and not longSetup and not shortSetup
    broke   = pDir == 1 ? close > pLvl : close < pLvl
    invalid = pDir == 1 ? close < pStop : close > pStop
    if broke
        longSig  := pDir == 1
        shortSig := pDir == -1
        line.set_x2(pLine, bar_index)
        line.set_x2(sLine, bar_index)
        pDir := 0
    else if invalid
        line.set_x2(pLine, bar_index)
        line.set_x2(sLine, bar_index)
        line.set_color(pLine, color.gray)
        pDir := 0
if pDir != 0
    line.set_x2(pLine, bar_index + 1)
    line.set_x2(sLine, bar_index + 1)

plotshape(longSig, "Compra", shape.triangleup, location.belowbar, upOutline, size = size.small, text = "COMPRA", textcolor = upOutline)
plotshape(shortSig, "Venta", shape.triangledown, location.abovebar, dnOutline, size = size.small, text = "VENTA", textcolor = dnOutline)

alertcondition(longSetup, "Nivel de compra listo", "VxD: retroceso débil terminado. Vigila la ruptura de la línea.")
alertcondition(shortSetup, "Nivel de venta listo", "VxD: rebote débil terminado. Vigila la ruptura de la línea.")
alertcondition(longSig, "COMPRA confirmada", "VxD: ruptura alcista tras retroceso débil.")
alertcondition(shortSig, "VENTA confirmada", "VxD: ruptura bajista tras rebote débil.")

// ───────────────────────────── Panel ─────────────────────────────
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(#0B1220, 10), border_color = color.new(color.gray, 70), border_width = 1)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "Velas dibujadas", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 0, tfLabel(htf) + " (dentro " + tfLabel(ltf) + ")", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Compradores", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(bpNow * 100, "#") + "%", text_color = buyCol, text_size = size.small)
    table.cell(tb, 0, 2, "Vendedores", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(100 - bpNow * 100, "#") + "%", text_color = sellCol, text_size = size.small)
    table.cell(tb, 0, 3, "Mandan", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 3, bpNow > 0.5 ? "COMPRADORES" : bpNow < 0.5 ? "VENDEDORES" : "Empate", text_color = bpNow >= 0.5 ? buyCol : sellCol, text_size = size.small)
    table.cell(tb, 0, 4, "Nivel activo", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 4, pDir == 1 ? "Compra > " + str.tostring(pLvl, format.mintick) : pDir == -1 ? "Venta < " + str.tostring(pLvl, format.mintick) : "—", text_color = color.yellow, text_size = size.small)
